# ATLAS generation and vector embeddings (Google Gemini)
GEMINI_API_KEY=
ATLAS_GEMINI_GENERATION_MODEL=gemini-1.5-flash
ATLAS_GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional process-external local inference (no model weights in Uvicorn).
ATLAS_OLLAMA_BASE_URL=http://localhost:11434
ATLAS_OLLAMA_MODEL=llama3.2:3b
ATLAS_OLLAMA_FALLBACK_MODEL=llama3.2:1b
ATLAS_OLLAMA_TEMPERATURE=0.2
# Two-tier generation: brief operational lookups receive 350 tokens; every
# other request receives this full response budget.
ATLAS_OLLAMA_MAX_TOKENS=2048
ATLAS_OLLAMA_STANDARD_MAX_TOKENS=350
ATLAS_OLLAMA_NUM_CTX=4096
# Eight-vCPU profile: retain one CPU for FastAPI, the OS, and background work.
ATLAS_OLLAMA_NUM_THREAD=7
ATLAS_OLLAMA_NUM_BATCH=512
# CPU long-form FDS generation can take several minutes; this is the maximum
# no-output interval for both non-streaming and streaming Ollama requests.
ATLAS_OLLAMA_TIMEOUT_SECONDS=600

# Canonical SLA warning threshold used by API, Stats, and Chat analytics.
ATLAS_SLA_WARNING_BUFFER_MINUTES=90

# Optional local Chroma persistence location.
# ATLAS_VECTOR_STORE_PATH=/secure/path/atlas-vector-db

# ServiceNow ITSM read connector (OAuth client credentials)
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=

# Veeva Vault QMS read connector (OAuth client credentials)
VEEVA_VAULT_URL=https://your-domain.veevavault.com
VEEVA_CLIENT_ID=
VEEVA_CLIENT_SECRET=

# HP ALM / Quality Center read connector (OAuth client credentials)
HP_ALM_BASE_URL=https://your-alm.example.com
HP_ALM_CLIENT_ID=
HP_ALM_CLIENT_SECRET=

# Google Drive KT/SUD Hub read connector (service-account credentials)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/google-service-account.json
