# ATLAS generation and vector embeddings (Google Gemini)
GEMINI_API_KEY=
ATLAS_GEMINI_GENERATION_MODEL=gemini-1.5-flash
ATLAS_GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional local Chroma persistence location.
# ATLAS_VECTOR_STORE_PATH=/secure/path/atlas-vector-db

# ServiceNow ITSM read connector (OAuth client credentials)
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=

# Veeva Vault QMS read connector (OAuth client credentials)
VEEVA_VAULT_URL=https://your-domain.veevavault.com
VEEVA_CLIENT_ID=
VEEVA_CLIENT_SECRET=

# HP ALM / Quality Center read connector (OAuth client credentials)
HP_ALM_BASE_URL=https://your-alm.example.com
HP_ALM_CLIENT_ID=
HP_ALM_CLIENT_SECRET=

# Google Drive KT/SUD Hub read connector (service-account credentials)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/google-service-account.json
