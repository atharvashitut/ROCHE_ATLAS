# ITSM-Copilot production configuration. Copy to a secret-managed .env file; do not commit real values.

# Select `live` only after all enterprise adapters have been configured and approved.
COPILOT_ADAPTER_MODE=live
UVICORN_WORKERS=4
CORS_ORIGINS=https://itsm-copilot.example.roche.com

# Vector database: use an internal TLS endpoint in production, not the local Compose hostname.
QDRANT_URL=https://qdrant.internal.example.roche.com
QDRANT_COLLECTION=itsm_knowledge_production

# GPT-Terra Vision adapter. Obtain the actual endpoint and credentials from the approved secret manager.
TERRA_VISION_BASE_URL=https://<approved-terra-vision-endpoint>
TERRA_VISION_API_KEY=<inject-from-secret-manager>
TERRA_VISION_MODEL=gpt-terra-vision

# OAuth client credentials for approved ServiceNow, Veeva, Google Drive, and CMDB adapters.
OAUTH_TOKEN_URL=https://<approved-oauth-authority>/oauth2/token
OAUTH_CLIENT_ID=<inject-from-secret-manager>
OAUTH_CLIENT_SECRET=<inject-from-secret-manager>
OAUTH_SCOPE=itsm-copilot.read itsm-copilot.write

# Live adapter base URLs. Replace placeholders only through the enterprise configuration process.
SERVICENOW_INSTANCE_URL=https://<approved-servicenow-instance>
VEEVA_VAULT_URL=https://<approved-veeva-vault>
GOOGLE_DRIVE_AUDIT_FOLDER_ID=<approved-audit-folder-id>
CMDB_API_URL=https://<approved-cmdb-endpoint>
